#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <39 38>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        DeleteKey {
            bindings = <&kp DELETE>;
            key-positions = <7 8>;
        };

        InsertKey {
            bindings = <&kp INSERT>;
            key-positions = <6 7>;
        };

        LeftClick {
            bindings = <&mkp MB1>;
            key-positions = <17 18>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 19>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <19 20>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <29 30>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <30 31>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        WIN {
            bindings = <
&kp Q             &kp W         &kp E         &kp R           &kp T                                        &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F           &kp G                       &kp SQT          &kp H        &kp J  &kp K      &kp L    &mt RIGHT_SHIFT MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V           &kp B        &kp F2         &lt 8 SEMICOLON  &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &kp LANGUAGE_2  &lt 6 LANG1  &lt 1 SPACE    &kp BACKSPACE    &lt 7 ENTER                             &kp RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_AC_SCROLL_DOWN C_AC_SCROLL_UP>;
        };

        WIN_SUB {
            bindings = <
&trans          &kp LC(LS(TAB))         &kp LG(TAB)    &kp LC(TAB)              &kp LG(SLASH)                     &kp F1  &kp F2              &kp F3              &kp F4               &kp F5
&trans          &kp LC(LG(LEFT_ARROW))  &kp LC(LG(D))  &kp LC(LG(RIGHT_ARROW))  &trans                    &trans  &kp F7  &kp LG(LEFT_ARROW)  &kp LG(D)           &kp LG(RIGHT_ARROW)  &kp LG(UP_ARROW)
&kp LEFT_SHIFT  &kp LA(LEFT_ARROW)      &trans         &kp LA(RIGHT_ARROW)      &kp LG(PERIOD)  &trans    &trans  &kp F8  &trans              &kp LG(DOWN_ARROW)  &trans               &kp NON_US_BACKSLASH
&kp LCTRL       &trans                  &trans         &trans                   &trans          &trans    &trans  &trans                                                               &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        MAC {
            bindings = <
&kp Q      &kp W         &kp E                    &kp R   &kp T                                        &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D                    &kp F   &kp G                       &kp SQT          &kp H        &kp J  &kp K      &kp L    &mt RIGHT_SHIFT MINUS
&kp Z      &kp X         &kp C                    &kp V   &kp B        &kp F14        &lt 8 SEMICOLON  &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL  &kp LEFT_WIN  &mt LANGUAGE_2 LEFT_ALT  &trans  &lt 6 ENTER  &lt 1 SPACE    &kp BACKSPACE    &lt 7 SPACE                             &kp ESCAPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MAC_SUB {
            bindings = <
&trans          &kp LC(LS(TAB))         &kp LG(TAB)    &kp LC(TAB)              &kp LG(SLASH)                     &kp F1  &kp F2              &kp F3              &kp F4               &kp F5
&trans          &kp LC(LG(LEFT_ARROW))  &kp LC(LG(D))  &kp LC(LG(RIGHT_ARROW))  &trans                    &trans  &kp F7  &kp LG(LEFT_ARROW)  &kp LG(D)           &kp LG(RIGHT_ARROW)  &kp LG(UP_ARROW)
&kp LEFT_SHIFT  &kp LA(LEFT_ARROW)      &trans         &kp LA(RIGHT_ARROW)      &kp LG(PERIOD)  &trans    &trans  &kp F8  &trans              &kp LG(DOWN_ARROW)  &trans               &kp NON_US_BACKSLASH
&kp LCTRL       &trans                  &trans         &trans                   &trans          &trans    &trans  &trans                                                               &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        IPAD {
            bindings = <
&kp Q      &kp W         &kp E                    &kp R   &kp T                                        &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D                    &kp F   &kp G                       &kp SQT          &kp H        &kp J  &kp K      &kp L    &mt RIGHT_SHIFT MINUS
&kp Z      &kp X         &kp C                    &kp V   &kp B        &kp F14        &lt 8 SEMICOLON  &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL  &kp LEFT_WIN  &mt LANGUAGE_2 LEFT_ALT  &trans  &lt 6 ENTER  &lt 1 SPACE    &kp BACKSPACE    &lt 7 SPACE                             &kp ESCAPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        IPAD_SUB {
            bindings = <
&trans          &kp LC(LS(TAB))         &kp LG(TAB)    &kp LC(TAB)              &kp LG(SLASH)                     &kp F1  &kp F2              &kp F3              &kp F4               &kp F5
&trans          &kp LC(LG(LEFT_ARROW))  &kp LC(LG(D))  &kp LC(LG(RIGHT_ARROW))  &trans                    &trans  &kp F7  &kp LG(LEFT_ARROW)  &kp LG(D)           &kp LG(RIGHT_ARROW)  &kp LG(UP_ARROW)
&kp LEFT_SHIFT  &kp LA(LEFT_ARROW)      &trans         &kp LA(RIGHT_ARROW)      &kp LG(PERIOD)  &trans    &trans  &kp F8  &trans              &kp LG(DOWN_ARROW)  &trans               &kp NON_US_BACKSLASH
&kp LCTRL       &trans                  &trans         &trans                   &trans          &trans    &trans  &trans                                                               &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        SYMNUM {
            bindings = <
&kp GRAVE             &kp EXCLAMATION  &kp QUESTION  &kp LEFT_BRACKET      &kp RIGHT_BRACKET                               &kp SLASH  &kp N7        &kp N8        &kp N9        &kp ASTERISK
&kp TILDE             &kp AMPERSAND    &kp HASH      &kp LEFT_BRACE        &kp RIGHT_BRACE                  &kp COMMA      &trans     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS
&kp DOLLAR            &kp AT_SIGN      &kp PERCENT   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans    &kp PERIOD     &kp N0     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PLUS
&kp NON_US_BACKSLASH  &kp PIPE         &trans        &trans                &trans                 &trans    &kp BACKSPACE  &kp EQUAL                                            &kp ESCAPE
            >;
        };

        FUNC {
            bindings = <
&trans          &trans          &trans          &trans           &trans                        &bootloader  &trans          &trans          &trans           &kp HOME
&kp TAB         &trans          &msc SCRL_UP    &trans           &trans                &trans  &trans       &mkp MB1        &kp UP_ARROW    &mkp MB2         &kp END
&kp LEFT_SHIFT  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &kp C_MUTE  &trans    &trans  &trans       &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_UP
&kp LCTRL       &trans          &trans          &trans           &trans      &trans    &trans  &trans                                                        &kp PAGE_DOWN
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                  &trans       &to 0           &to 0         &to 2         &trans        &trans
&trans        &trans        &trans        &trans        &trans        &trans    &trans       &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                                            &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
